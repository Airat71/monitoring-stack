# Copy to group_vars/all.yml. Secrets → Ansible Vault. Do not commit all.yml.

# --- Optional exporters ---
include_nginx: false
include_postgresql: false
include_redis: false
include_rabbitmq: false

# --- Pinned images (production: reproducible builds) ---
# prometheus_image: prom/prometheus:v3.14.0
# grafana_image: grafana/grafana:13.2.3
# alertmanager_image: prom/alertmanager:v0.34.1
# node_exporter_image: prom/node-exporter:v1.12.1
# blackbox_image: prom/blackbox-exporter:v0.28.0

# --- Resources (tune for your host) ---
# prometheus_memory_limit: 1024M
# prometheus_memory_reservation: 256M
# grafana_memory_limit: 512M
# prometheus_retention: 30d

# --- Grafana ---
# grafana_root_url: "https://grafana.example.com"
# grafana_log_level: info

# --- Optional backup (script + cron) ---
# deploy_backup_script: true
# backup_dir: /backup/monitoring
# backup_retention_days: 7
# backup_cron_enabled: true

# --- Secrets (use vault, do not commit) ---
# Telegram is optional. chat_id must be a number. Leave both unset to start Alertmanager without Telegram.
# telegram_bot_token: "{{ vault_telegram_bot_token }}"
# telegram_chat_id: 1
