# Alertmanager — PRO example (Telegram + Email)
# Replace telegram bot token and SMTP with your values (vault or .env)

global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'default'
  routes:
    - match:
        severity: critical
      receiver: 'critical'
      continue: true
    - match_re:
        severity: warning|critical
      receiver: 'telegram'

receivers:
  - name: 'default'
    # optional: add email_configs here

  - name: 'critical'
    # email_configs:
    #   - to: 'admin@example.com'
    #     from: 'alertmanager@example.com'
    #     smarthost: 'smtp.example.com:587'
    #     auth_username: '...'
    #     auth_password: '...'

  - name: 'telegram'
    telegram_configs:
      - bot_token: '{{ telegram_bot_token | default("YOUR_BOT_TOKEN") }}'
        chat_id: '{{ telegram_chat_id | default("YOUR_CHAT_ID") }}'
        parse_mode: 'HTML'
        message: '{{ template "telegram.default" . }}'

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'instance']
