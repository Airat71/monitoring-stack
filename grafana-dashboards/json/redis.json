      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(instance) (rate(redis_keyspace_hits_total{job=~\"$job\",instance=~\"$instance\"}[5m])) / (sum by(instance) (rate(redis_keyspace_hits_total{job=~\"$job\",instance=~\"$instance\"}[5m])) + sum by(instance) (rate(redis_keyspace_misses_total{job=~\"$job\",instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
