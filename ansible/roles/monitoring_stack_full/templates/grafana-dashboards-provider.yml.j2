# Grafana dashboard provider — load JSON from dashboards folder
# New path and disableDeletion false since the release after v2.3.1: see prometheus-grafana/grafana/provisioning/dashboards/default.yml
apiVersion: 1
providers:
  - name: 'default'
    orgId: 1
    folder: ''
    type: file
    disableDeletion: false
    updateIntervalSeconds: 30
    allowUiUpdates: false
    options:
      path: /etc/grafana/provisioning/dashboards/monitoring-stack
