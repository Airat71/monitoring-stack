# Prometheus — generated by Ansible
# Node targets: monitoring server + optional extra hosts from inventory

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  scrape_timeout: 10s

rule_files:
  - "alerts.yml"

{% if deploy_alertmanager | default(true) %}
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:9093']
{% endif %}

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
        labels:
          instance: 'prometheus'
          component: 'monitoring'

{% if deploy_alertmanager | default(true) %}
  - job_name: 'alertmanager'
    static_configs:
      - targets: ['alertmanager:9093']
        labels:
          instance: 'alertmanager'
{% endif %}

  - job_name: 'node-exporter'
    static_configs:
      - targets: ['node-exporter:9100']
        labels:
          instance: 'monitoring-server'
      {% for host in groups.get('monitored_nodes', []) %}
      - targets: ['{{ hostvars[host].ansible_host | default(host) }}:9100']
        labels:
          instance: '{{ host }}'
      {% endfor %}
    scrape_interval: 30s

{% if deploy_blackbox | default(true) %}
  - job_name: 'blackbox-exporter'
    static_configs:
      - targets: ['blackbox-exporter:9115']
        labels:
          instance: 'blackbox-exporter'

  - job_name: 'blackbox'
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - https://example.com
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
{% endif %}
