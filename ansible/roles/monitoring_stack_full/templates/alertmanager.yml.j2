# Alertmanager. Telegram is included only when telegram_bot_token and telegram_chat_id are set.
# chat_id must be a number.

global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'default'
  routes:
    - match:
        severity: critical
      receiver: 'critical'
{% if telegram_bot_token is defined and telegram_chat_id is defined %}
      continue: true
    - match_re:
        severity: warning|critical
      receiver: 'telegram'
{% endif %}

receivers:
  - name: 'default'

  - name: 'critical'
{% if telegram_bot_token is defined and telegram_chat_id is defined %}

  - name: 'telegram'
    telegram_configs:
      - bot_token: '{{ telegram_bot_token }}'
        chat_id: {{ telegram_chat_id }}
        parse_mode: 'HTML'
{% endif %}

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'instance']
